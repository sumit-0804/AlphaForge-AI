APP_NAME=AlphaForge AI
APP_ENV=development
API_PREFIX=/api
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=alphaforge

# Singular. Settings.cors_origin is the field name, so CORS_ORIGINS (plural) is
# silently ignored and the backend falls back to localhost — which shows up as
# every request from a deployed frontend being blocked by the browser.
# Comma-separated for more than one origin, no trailing slashes.
CORS_ORIGIN=http://localhost:3000

# Powers both the reasoning agents and the FAISS memory embeddings.
GOOGLE_API_KEY=

# Model quota caps. Per-minute overruns make callers wait; the per-day cap rejects
# with 429 instead, since it only frees up at midnight US Pacific. Check the console
# figures for the model you actually run — they differ per model — and stay under
# them, because the estimate is approximate until the reply's real token count lands.
GEMINI_RPM=12
GEMINI_RPD=400
EMBEDDING_RPM=80
EMBEDDING_RPD=800
# Where the daily counter rolls over. Google's quota day is Pacific, not local.
QUOTA_RESET_TIMEZONE=America/Los_Angeles

# Signs the session tokens. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving the built-in default means anyone can forge a token for any account.
JWT_SECRET=
# How long a login lasts before the user has to sign in again.
ACCESS_TOKEN_TTL_MINUTES=10080
# Set false once your accounts exist so a public URL can't accrue new ones.
ALLOW_REGISTRATION=true
