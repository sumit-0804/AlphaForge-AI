graph TB
    %% Hand-authored. Source: app/agents/reflection_agent.py
    %% Triggered from TradingService.execute_trade on a SELL, awaited in request scope.

    SELL(["paper trade closed<br/><i>POST /trading/execute · SELL</i>"]) --> AW["awaited inside the request<br/><i>not a detached task — Cloud Run<br/>throttles CPU after the response</i>"]
    AW --> PNL["compute realised P&L<br/>absolute + percent"]
    PNL --> PRIOR["recall prior lessons<br/>for this ticker · k=3"]
    PRIOR --> CALL["chat_json · Reflection schema<br/><i>max 2 repair retries</i>"]
    CALL --> VAL{"valid<br/>reflection?"}
    VAL -->|"no"| NONE(["store nothing<br/><i>outcome still derived from P&L</i>"])
    VAL -->|"yes"| SAVE["MemoryService.save<br/>type: lesson"]
    SAVE --> EMB["Gemini embedding<br/><i>gemini-embedding-2 · 1536 dims</i>"]
    EMB --> MEM[("memories<br/><i>text + vector on one document</i>")]
    EMB -.->|"embedding failed"| ERR["saved anyway with<br/>metadata._index_error"]
    ERR --> MEM

    MEM -.->|"$vectorSearch"| PRIOR
    MEM ==>|"same-ticker and cross-ticker<br/>lessons, via the recall node"| WF(["every future workflow run<br/>research · debate moderator"])

    NOTE["Why invalid output is dropped: a lesson is<br/>permanent and gets replayed into later<br/>debates, including on other tickers"]
    VAL -.- NOTE

