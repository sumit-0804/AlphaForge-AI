graph LR
    %% Hand-authored — NOT generated from code. Update when architecture changes.
    %% Organised by what TRIGGERS each agent, since that is the thing the
    %% per-graph diagrams cannot show. Graph internals live in mermaid.png.

    subgraph TRIG["Triggers · all user-initiated"]
        T1["Ideas · Scan<br/><i>GET /scanner</i>"]
        T2["Stock page · Analyse<br/><i>SSE /workflow/{t}/stream</i>"]
        T3["Buy / Sell<br/><i>POST /trading/execute</i>"]
        T4["Book · Ask advisor<br/><i>GET /advisor/suggestions</i>"]
        T5["Daily report<br/><i>POST /reports/daily</i>"]
        T6["Stock page · live price<br/><i>WS /live</i>"]
    end

    subgraph DET["Deterministic core · no LLM"]
        S1["MarketScanner<br/>discovery · entry + exit signals"]
        S2["Indicators · Fundamentals<br/>Risk · Allocation"]
        S3["Trading · Forex"]
        S4["Live price hub"]
    end

    subgraph LLM["LLM agents · Gemini via chat_json · RateLimiter"]
        A1["Scanner triage<br/><i>1 call per scan</i>"]
        WF["LangGraph workflow<br/><i>3 calls quick · 8 calls debate</i>"]
        A2["Portfolio advisor<br/><i>1 call per book</i>"]
        A3["Reflection<br/><i>1 call per sell · awaited</i>"]
        A4["Risk + portfolio narration<br/><i>2 calls per report</i>"]
    end

    subgraph STORE["MongoDB Atlas"]
        D1[("portfolios · transactions<br/>recommendations · daily_reports")]
        D2[("memories<br/><i>Atlas Vector Search</i>")]
        D3[("checkpoints<br/><i>3-day TTL</i>")]
    end

    MKT["yfinance REST + WebSocket<br/>Google News RSS · Frankfurter FX"]

    T1 --> S1 --> A1
    T2 --> WF
    WF --> S2
    T3 --> S3
    S3 -->|"on SELL"| A3
    T4 --> A2
    A2 -->|"exit signals"| S1
    T5 --> S2 --> A4
    T6 --> S4

    WF -->|"recommendation"| D1
    WF -->|"agent_output"| D2
    WF <-->|"resume"| D3
    A3 -->|"lesson"| D2
    D2 -.->|"lessons recalled"| WF
    S3 --> D1
    A4 --> D1

    S1 & S2 & S4 ==> MKT

